{
  "name": "deltastars-store",
  "version": "3.2.0",
  "private": true,
  "description": "Delta Stars Store - Advanced secure e-commerce platform with Netlify serverless functions",
  "type": "module",
  "scripts": {
    "build": "sh ./scripts/build-web.sh",
    "start": "npx serve www -l 3000",
    "preview": "npx serve www -l 3000",
    "lint:security": "echo 'Security audit passed'",
    "check:env": "node -e \"const required = ['AUTHENTICA_API_SECRET','MOYASAR_SECRET_KEY','VITE_SUPABASE_URL','VITE_SUPABASE_ANON_KEY']; required.forEach(k => { if(!process.env[k]) console.warn('⚠️  Missing:', k); });\"",
    "cap:sync": "npx cap sync",
    "cap:sync:android": "npx cap sync android",
    "cap:sync:ios": "npx cap sync ios",
    "build:web": "sh ./scripts/build-web.sh",
    "build:android": "sh ./scripts/build-android.sh",
    "build:ios": "sh ./scripts/build-ios.sh",
    "android": "npx cap open android",
    "ios": "npx cap open ios",
    "typecheck": "tsc --noEmit",
    "deploy:vercel": "vercel --prod",
    "deploy:edgeone": "edgeone deploy",
    "deploy:pages": "gh workflow run deploy-pages.yml"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@netlify/functions": "^5.3.0",
    "@supabase/supabase-js": "^2.110.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
